PORT=8000

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_base64_or_key_here
AZURE_STORAGE_CONTAINER_NAME=your_container_name

# Chat encryption key (32 bytes hex or base64)
CHAT_ENCRYPTION_KEY=your_64_char_hex_or_base64

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=your_bucket_name

# GCS
GCS_KEY_FILE = path/to/gcs-key.json
GCS_BUCKET_NAME=your_gcs_bucket

# News API
NEWS_API_KEY=your_news_api_key

# Redis
REDIS_URL=redis://default:password@host:6379

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
MAIL_FROM_ADDRESS=your_email@example.com

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# MPESA
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASS_KEY=your_mpesa_pass_key
MPESA_PAYBILL=your_paybill
MPESA_CALLBACK_URL=https://your-callback-url

# OpenAI
OPENAI_API_KEY=your_openai_api_key
