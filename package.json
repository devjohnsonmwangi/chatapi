{
  "name": "wakili-api-eng-johnson",
  "type": "module", 
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "push": "drizzle-kit push",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tsc && cpx \"src/assets/**/*\" dist/assets",
    "serve": "cross-env NODE_OPTIONS='--max-old-space-size=4096' node dist/index.js",
    "start": "pnpm run build && pnpm run serve",
    "lint": "eslint . --ext .ts,.tsx",
    "analyze": "pnpm run build && node --inspect-brk dist/index.js",
    "preview": "cross-env NODE_OPTIONS='--max-old-space-size=4096' node dist/index.js",
    "dev:api": "nodemon --exec 'tsx' src/index.ts",
    "generate-chat-key": "ts-node ./src/utils/encryption.ts --generate-key"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@azure/storage-blob": "^12.26.0",
    "@google-cloud/storage": "^7.15.1",
    "@hono/node-server": "^1.13.7",
    "@hono/prometheus": "^1.0.1",
    "@hono/zod-validator": "^0.2.2",
    "@neondatabase/serverless": "^0.9.5",
    "@supabase/storage-js": "^2.7.1",
    "@supabase/supabase-js": "^2.48.1",
    "@types/express": "^5.0.1",
    "agenda": "^5.0.0",
    "async-limiter": "^1.0.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.5.1",
    "compromise": "^14.14.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.4",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "hono": "^4.7.1",
    "hono-rate-limiter": "^0.4.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.16",
    "openai": "^4.72.0",
    "p-limit": "^4.0.0",
    "pg": "^8.13.3",
    "postgres": "^3.4.5",
    "puppeteer": "^24.9.0",
    "socket.io-client": "^4.8.1",
    "stripe": "^16.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/socket.io": "^3.0.2",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.22.8",
    "eslint": "^8.57.0",
    "nodemon": "^2.0.22",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}